+static void test_waiting_marker_and_attention_cue(const char *directory)
+{
+    dashboard_session_t session = {.project = "marker", .provider = "CODEX",
+        .detail = "?", .work = DASH_SETTLED, .health = DASH_CURRENT};
+    const dashboard_motion_render_row_t row = {.session = &session, .y = 100,
+        .height = DASHBOARD_MOTION_ROW_HEIGHT};
+    render_rows(&row, 1, expected_frame);
+    for (int y = 100; y < 124; ++y) {
+        for (int x = 8; x < 11; ++x)
+            assert(pixel(expected_frame, x, y) == (y < 104 || y >= 120));
+        assert(pixel(expected_frame, 11, y));
+    }
+    session.work = DASH_WORKING;
+    render_rows(&row, 1, expected_frame);
+    assert_band_white(expected_frame, 8, 12, 100, 124);
+    session.work = DASH_SETTLED;
+    session.health = DASH_STALE;
+    render_rows(&row, 1, expected_frame);
+    assert_band_white(expected_frame, 8, 12, 100, 124);
+
+    static dashboard_motion_t motion;
+    dashboard_motion_init(&motion);
+    dashboard_motion_sample_t item = sample("codex@host/cue", "attention", "CODEX", "CUE1",
+        DASH_NEEDS_INPUT, DASH_CURRENT, false, 0, 1);
+    apply_ok(&motion, &item, 1, 1000);
+    assert(!dashboard_motion_attention_active(&motion)); // Existing requests start steady.
+    item.work = DASH_WORKING;
+    ++item.state_episode;
+    apply_ok(&motion, &item, 1, 1500);
+    item.work = DASH_NEEDS_INPUT;
+    ++item.state_episode;
+    apply_ok(&motion, &item, 1, 2000);
+    assert(!dashboard_motion_active(&motion)); // Cue works without row movement.
+    assert(dashboard_motion_attention_active(&motion));
+    render_at(&motion, 2000, frame_initial);
+    save_pbm(directory, "attention-icon-on", frame_initial);
+    apply_ok(&motion, &item, 1, 2100);
+    assert(motion.tracks[track_index(&motion, item.logical_id)].attention_started_ms == 2000);
+    render_at(&motion, 2200, frame_halfway);
+    save_pbm(directory, "attention-icon-off", frame_halfway);
+    assert(memcmp(frame_initial, frame_halfway, RLCD_FRAME_BYTES) != 0);
+    for (int y = 0; y < RLCD_HEIGHT; ++y)
+        for (int x = 0; x < RLCD_WIDTH; ++x)
+            if (pixel(frame_initial, x, y) != pixel(frame_halfway, x, y))
+                assert(x >= 12 && x < 24 && y >= 30 && y < 42);
+    render_at(&motion, 2400, frame_endpoint);
+    assert(memcmp(frame_initial, frame_endpoint, RLCD_FRAME_BYTES) == 0);
+    render_at(&motion, 2600, frame_endpoint);
+    assert(memcmp(frame_halfway, frame_endpoint, RLCD_FRAME_BYTES) == 0);
+    render_at(&motion, 2900, frame_endpoint);
+    assert(!dashboard_motion_attention_active(&motion));
+    assert(memcmp(frame_initial, frame_endpoint, RLCD_FRAME_BYTES) == 0);
+    ++item.state_episode; // A new question in the same work state is a new cue.
+    apply_ok(&motion, &item, 1, 3000);
+    assert(dashboard_motion_attention_active(&motion));
+    assert(dashboard_motion_feed_lost(&motion, DASH_STALE, 3100) == DASHBOARD_MOTION_APPLIED);
+    assert(!dashboard_motion_attention_active(&motion));
+    apply_ok(&motion, &item, 1, 3200);
+    assert(!dashboard_motion_attention_active(&motion)); // Recovery does not replay a cue.
+    ++item.state_episode;
+    apply_ok(&motion, &item, 1, 3300);
+    assert(dashboard_motion_attention_active(&motion));
+    item.work = DASH_SETTLED;
+    ++item.state_episode;
+    apply_ok(&motion, &item, 1, 3350);
+    assert(!dashboard_motion_attention_active(&motion));
+}
